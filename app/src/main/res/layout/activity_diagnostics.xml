<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="JARVIS SYSTEM STATUS"
        android:textColor="#CFE8FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#0A0F14">

        <TextView
            android:id="@+id/diag_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:text="Checking…\n"
            android:textColor="#B9D4E8"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

    <Button
        android:id="@+id/diag_refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RE-RUN CHECKS" />
</LinearLayout>
