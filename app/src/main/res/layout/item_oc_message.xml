<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161B22"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_role"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#21262D"
            android:padding="3dp"
            android:textColor="#8B949E"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_agent_model"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#484F58"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_message_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#C9D1D9"
        android:textIsSelectable="true"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txt_reasoning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#0D1117"
        android:padding="4dp"
        android:textColor="#8B949E"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
