<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UNIVERSAL MODEL TEST LAB"
                android:textColor="#38BDF8"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btn_refresh_status"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="REFRESH"
                android:textSize="11sp"
                android:backgroundTint="#1E293B"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- Engine Status Dashboard Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#131B2E"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ LIVE ENGINE STATUS DASHBOARD"
                android:textColor="#F59E0B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txt_needle_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Needle: Checking..."
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/txt_qwen_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Qwen: Checking..."
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txt_agy_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AGY Agent: Checking..."
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Model Execution Lab Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 INTERACTIVE PIPELINE TEST LAB"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Engine:"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinner_engine"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1E293B"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp" />

        <!-- Quick Sample Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/chip_torch"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Turn on flashlight"
                    android:textSize="10sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#E2E8F0"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/chip_torch_hinglish"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Torch chalu kar"
                    android:textSize="10sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#E2E8F0"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/chip_math"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="What is 2 + 2?"
                    android:textSize="10sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#E2E8F0"
                    android:layout_marginEnd="6dp" />
                <Button
                    android:id="@+id/chip_reasoning"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Explain Kotlin crash"
                    android:textSize="10sp"
                    android:backgroundTint="#1E293B"
                    android:textColor="#E2E8F0" />
            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/edit_prompt_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Type test command or reasoning prompt…"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:background="#1E293B"
            android:padding="12dp"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_run_test"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="RUN INFERENCE"
                android:textStyle="bold"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_test_identity"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="TEST ENGINE IDENTITY"
                android:textStyle="bold"
                android:backgroundTint="#D97706"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Pipeline Inspector Output Box -->
        <TextView
            android:id="@+id/txt_pipeline_inspector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="12dp"
            android:text="Pipeline results will render here..."
            android:textColor="#A7F3D0"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:layout_marginBottom="24dp" />

        <!-- TTS Benchmark Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊 KOKORO-82M NEURAL TTS BENCHMARK"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_tts_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Okay, turning on the flashlight now."
            android:textColor="#FFFFFF"
            android:background="#1E293B"
            android:padding="10dp"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_tts_benchmark"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="TEST TTS SPEECH"
                android:backgroundTint="#059669"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_tts_stop"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="STOP SPEECH"
                android:backgroundTint="#DC2626"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_tts_benchmark_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="10dp"
            android:text="TTS Metrics: Ready"
            android:textColor="#FDE047"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:layout_marginBottom="24dp" />

        <!-- Real-World Tool Audit Section -->
        <Button
            android:id="@+id/btn_run_tool_audit"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="RUN REAL-WORLD TOOL AUDIT (10 BATCHES)"
            android:textStyle="bold"
            android:backgroundTint="#7C3AED"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txt_tool_audit_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111827"
            android:padding="12dp"
            android:text="Tool Audit Report: Press button above to execute safe validation across all canonical tools."
            android:textColor="#93C5FD"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
