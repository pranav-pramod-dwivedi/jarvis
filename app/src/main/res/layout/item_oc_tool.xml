<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/txt_tool_status"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:background="#21262D"
        android:gravity="center"
        android:padding="2dp"
        android:textColor="#8B949E"
        android:textSize="9sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_tool_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#C9D1D9"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_tool_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#6E7681"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_tool_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#484F58"
        android:textSize="9sp" />
</LinearLayout>
