<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_agent_step_dialog"
    android:padding="16dp">

    <!-- Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/txt_dialog_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="📅 Session History"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_dialog_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:background="@android:color/transparent" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sessions ordered Last Used First • Named by creation date/time"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:layout_marginBottom="12dp" />

    <!-- Action Button: New Session -->
    <Button
        android:id="@+id/btn_dialog_new_session"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="➕ Start New Session"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="13sp"
        android:background="@drawable/bg_btn_mic_orange"
        android:layout_marginBottom="12dp" />

    <!-- Session List -->
    <ListView
        android:id="@+id/list_sessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="8dp"
        android:scrollbars="vertical" />

</LinearLayout>
