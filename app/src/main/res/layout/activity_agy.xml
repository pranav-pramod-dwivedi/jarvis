<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#151D2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back" />

        <View
            android:id="@+id/dot_status"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="#EF4444" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AGY CONSOLE"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/label_server_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking 127.0.0.1:5050..."
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_server_toggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#2563EB"
            android:paddingHorizontal="10dp"
            android:text="START"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_web_console"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#1E293B"
            android:paddingHorizontal="10dp"
            android:text="WEB UI"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_connect_services"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#7C3AED"
            android:paddingHorizontal="10dp"
            android:text="CONNECT"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Model Info & Session Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/txt_agy_session_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 01 Sep 2026, 01:36:15 AM"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_agy_sessions"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="#1E293B"
            android:paddingHorizontal="8dp"
            android:text="History ▾"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_new_chat"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#2563EB"
            android:paddingHorizontal="10dp"
            android:text="+ New"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_output"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#1E293B"
            android:paddingHorizontal="8dp"
            android:text="Clear"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Terminal Output -->
    <ScrollView
        android:id="@+id/output_scroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#080C13"
        android:fillViewport="true">

        <TextView
            android:id="@+id/output_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textIsSelectable="true"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />
    </ScrollView>

    <!-- Quick Chips Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_torch"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="🔦 Torch"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_battery"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="🔋 Battery"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_youtube"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="▶️ YouTube"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_alarm"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="⏰ Alarm 7AM"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_timer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="⏳ Timer 10m"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_volume_down"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="🔉 Vol Down"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_volume_up"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="🔊 Vol Up"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_weather"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="🌤️ Weather"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_home"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="🧭 Home"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_screenshot"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="📸 Screenshot"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_settings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="⚙️ Settings"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_music"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="🎵 Music"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_help"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="agy --help"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_status"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="Status"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_pwd"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E293B"
                android:text="pwd"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chip_files"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#0369A1"
                android:text="📁 Files"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_opencode"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#4338CA"
                android:text="🤖 OpenCode"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_terminal"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#047857"
                android:text="💻 Terminal"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_diagnostics"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#B45309"
                android:text="⚡ Diagnostics"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_capabilities"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#059669"
                android:text="🛠️ Capabilities"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chip_dashboard"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#7C3AED"
                android:text="📊 Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#151D2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/input_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#0B0F17"
            android:hint="Ask Antigravity (AGY)..."
            android:maxLines="4"
            android:minHeight="42dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_voice_mic"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#8B5CF6"
            android:text="🎙️"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_send"
            android:layout_width="72dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#38BDF8"
            android:text="SEND"
            android:textColor="#030712"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_abort"
            android:layout_width="72dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#EF4444"
            android:text="STOP"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
