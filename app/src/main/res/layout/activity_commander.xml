<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="JARVIS COMMANDER"
        android:textColor="#CFE8FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cmd_ctx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="#6E8CA0"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cmd_via_termux"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:text="TERMUX" />

        <Button
            android:id="@+id/cmd_via_local"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:text="LOCAL" />

        <Button
            android:id="@+id/cmd_via_root"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:text="ROOT" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/cmd_scroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="#0A0F14">

        <TextView
            android:id="@+id/cmd_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="#B9D4E8"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/cmd_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:hint="command…"
            android:inputType="text"
            android:textColor="#E6F2FF"
            android:textColorHint="#556B7E" />

        <Button
            android:id="@+id/cmd_run"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RUN" />
    </LinearLayout>
</LinearLayout>
