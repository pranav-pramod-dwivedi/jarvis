<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E14"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← BACK"
            android:textSize="12sp"
            android:backgroundTint="#1F2937" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="CANONICAL TOOL PLAYGROUND"
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Natural language normalizer section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Test Natural Language Intent"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/input_nl_query"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1E293B"
            android:hint="e.g. 'call Akhil', 'ghar ka rasta bata'"
            android:padding="10dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_normalize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#0284C7"
            android:text="NORMALIZE"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Direct Canonical Tool Runner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Direct Tool Execution"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinner_tools"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="#1E293B" />

    <EditText
        android:id="@+id/input_args_json"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="6dp"
        android:background="#1E293B"
        android:fontFamily="monospace"
        android:gravity="top"
        android:hint="{&quot;destination&quot;: &quot;home&quot;}"
        android:padding="8dp"
        android:textColor="#38BDF8"
        android:textColorHint="#64748B"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_execute_tool"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#16A34A"
            android:text="EXECUTE CANONICAL TOOL"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#334155"
            android:text="CLEAR"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Console output -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Execution Console / Result"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/log_scroller"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="#0F172A"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_tool_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Ready.\nSelect a canonical tool or enter a natural prompt to test."
            android:textColor="#E2E8F0"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>
