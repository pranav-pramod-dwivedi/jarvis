<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_step_card"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Creation Date & Time Title -->
        <TextView
            android:id="@+id/item_session_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/item_session_badge"
            android:layout_alignParentStart="true"
            android:text="01 Sep 2026, 01:36:15 AM"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Type Badge (CHAT / VOICE / AGY CODE) -->
        <TextView
            android:id="@+id/item_session_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/item_session_btn_delete"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:text="💬 CHAT"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <!-- Delete Session Button -->
        <TextView
            android:id="@+id/item_session_btn_delete"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="🗑"
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:background="@android:color/transparent" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/item_session_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4 turns • Active 2m ago • /sdcard"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/item_session_active_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
