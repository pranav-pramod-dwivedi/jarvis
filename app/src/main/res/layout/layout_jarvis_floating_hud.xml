<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_overlay_half_sheet">

    <!-- Glowing Siri Replica Background Layer -->
    <ImageView
        android:id="@+id/hud_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_siri_replica_glow"
        android:scaleType="fitXY" />

    <!-- Main Half-Screen Overlay Content -->
    <LinearLayout
        android:id="@+id/hud_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Top Header: Handle + 3 Action Buttons (- [ ] ✕) -->
        <RelativeLayout
            android:id="@+id/hud_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Sheet top drag pill handle -->
            <View
                android:layout_width="38dp"
                android:layout_height="4.5dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_hud_circle_btn"
                android:backgroundTint="#4DFFFFFF" />

            <!-- Window Buttons on the right -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btn_hud_minimize"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_hud_circle_btn"
                    android:src="@drawable/ic_hud_minimize"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:contentDescription="Minimize" />

                <ImageView
                    android:id="@+id/btn_hud_maximize"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_hud_circle_btn"
                    android:src="@drawable/ic_hud_maximize"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:contentDescription="Open Session in App" />

                <ImageView
                    android:id="@+id/btn_hud_close"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_hud_circle_btn"
                    android:src="@drawable/ic_hud_close"
                    android:scaleType="centerInside"
                    android:padding="5dp"
                    android:contentDescription="Close" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Siri Animated Orb (unstretched, feathered radial fade to black) -->
        <FrameLayout
            android:id="@+id/hud_orb_container"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp">

            <TextureView
                android:id="@+id/hud_video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Subtitle: Listening (Muted White SF Pro, as it was) -->
        <TextView
            android:id="@+id/hud_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:text="Listening"
            android:fontFamily="@font/sf_pro"
            android:textColor="#99FFFFFF"
            android:textSize="15sp"
            android:letterSpacing="0.01"
            android:gravity="center" />

        <!-- Main Query / State Text (Bold White SF Pro, disappears when chat starts) -->
        <TextView
            android:id="@+id/hud_main_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="How can I help\nyou today?"
            android:fontFamily="@font/sf_pro"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15" />

        <!-- Chat Stream: Real-Time Bubbles with Live STT and TTS Word Highlights -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hud_chat_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Floating Compact Bubble (when minimized) -->
    <FrameLayout
        android:id="@+id/hud_floating_bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_orb_idle"
        android:visibility="gone"
        android:elevation="16dp">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_round_glow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="J"
            android:fontFamily="@font/sf_pro"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
