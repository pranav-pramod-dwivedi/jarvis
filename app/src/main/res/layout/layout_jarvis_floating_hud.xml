<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <!-- Glowing Futuristic Card Container -->
    <LinearLayout
        android:id="@+id/hud_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_agent_input_bar"
        android:padding="20dp"
        android:elevation="12dp">

        <!-- Top Header: Logo, Status Pill, Close / Minimize Buttons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true">

                <View
                    android:id="@+id/hud_status_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:id="@+id/hud_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="JARVIS HUD"
                    android:textColor="#00E5FF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/hud_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="LISTENING"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true">

                <TextView
                    android:id="@+id/btn_hud_minimize"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="🗕"
                    android:textColor="#94A3B8"
                    android:textSize="16sp"
                    android:background="@android:color/transparent" />

                <TextView
                    android:id="@+id/btn_hud_close"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#EF4444"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Stark Sine Waveform Visualizer -->
        <com.pr4nav.jarvis.gui.StarkWaveformView
            android:id="@+id/hud_waveform"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Live Transcription Box -->
        <TextView
            android:id="@+id/hud_transcription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Listening to voice command…"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="normal"
            android:padding="8dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- AI Speech & Outcome Card -->
        <TextView
            android:id="@+id/hud_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JARVIS online and ready, sir."
            android:textColor="#67E8F9"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:padding="10dp"
            android:background="@drawable/bg_chat_agent"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Quick Action Chips Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_hud_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛑 Stop Speech"
                    android:textColor="#F87171"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_prompt_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_hud_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙️ Listen Again"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:background="@drawable/bg_prompt_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_hud_screen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱 Read Screen"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:background="@drawable/bg_prompt_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/chip_hud_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 Open Chat"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:background="@drawable/bg_prompt_chip"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Floating Compact Bubble (when minimized) -->
    <FrameLayout
        android:id="@+id/hud_floating_bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_orb_idle"
        android:visibility="gone"
        android:elevation="16dp">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_round_glow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="J"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
