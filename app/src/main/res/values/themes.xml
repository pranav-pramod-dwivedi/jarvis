<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- JARVIS: dark, cyan-accented, no action bar (custom headers). -->
    <style name="Theme.Jarvis" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/jv_surface_hi</item>
        <item name="colorPrimaryVariant">@color/jv_bg</item>
        <item name="colorOnPrimary">@color/jv_text</item>
        <item name="colorSecondary">@color/jv_accent</item>
        <item name="colorSecondaryVariant">@color/jv_accent_dim</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/jv_bg</item>
        <item name="android:statusBarColor">@color/jv_bg</item>
        <item name="android:navigationBarColor">@color/jv_bg</item>
        <item name="android:textColor">@color/jv_text</item>
    </style>
</resources>
