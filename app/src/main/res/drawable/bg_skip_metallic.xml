<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#5038BDF8">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#64748B"
                android:centerColor="#1E293B"
                android:endColor="#0F172A"
                android:type="linear" />
            <stroke
                android:width="1.2dp"
                android:color="#E2E8F0" />
            <corners android:radius="24dp" />
            <padding
                android:left="16dp"
                android:top="8dp"
                android:right="16dp"
                android:bottom="8dp" />
        </shape>
    </item>
</ripple>
